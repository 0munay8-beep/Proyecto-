# ============================================
# DATABASE CONFIG
# ============================================
DATABASE_URL=postgresql://bus_user:bus_password@localhost:5432/bus_management
SQLALCHEMY_ECHO=False

# ============================================
# SECURITY & JWT
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production-12345
JWT_SECRET=your-jwt-secret-key-change-in-production-67890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# REDIS & CACHE
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# ============================================
# CELERY & ASYNC TASKS
# ============================================
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# ============================================
# CORS & API
# ============================================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
API_TITLE=Bus Management System
API_VERSION=1.0.0

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ============================================
# TWILIO (SMS NOTIFICATIONS)
# ============================================
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Bus Management System

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ============================================
# ML & OPTIMIZATION
# ============================================
MODEL_UPDATE_INTERVAL=3600
ANOMALY_THRESHOLD=0.85
FORECAST_DAYS=7
CLUSTER_NUMBERS=5

# ============================================
# MAPS & GEOLOCATION
# ============================================
MAP_DEFAULT_LAT=10.3910
MAP_DEFAULT_LON=-75.4794
MAP_DEFAULT_ZOOM=12
GEOCODER_PROVIDER=nominatim

# ============================================
# OPTIMIZATION ALGORITHMS
# ============================================
GENETIC_ALGORITHM_POPULATION=100
GENETIC_ALGORITHM_GENERATIONS=50
SIMULATED_ANNEALING_TEMP=1000
SIMULATED_ANNEALING_COOLING_RATE=0.95

# ============================================
# PERFORMANCE
# ============================================
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
WORKER_THREADS=4